rules_version = '2';

// Señales y Sistemas — reglas de Firestore
// ----------------------------------------
// Leer:     cualquiera (el curso es público).
// Escribir: solo docentes. Un docente es una cuenta de Google con correo
//           verificado que tiene un documento en la colección `admins`, cuyo
//           ID es su correo en minúsculas (se crea a mano en la consola).
//
// Publicar estas reglas: consola de Firebase → Firestore → Reglas → pegar y
// «Publicar», o `firebase deploy --only firestore:rules`.

service cloud.firestore {
  match /databases/{database}/documents {

    // Límite holgado para un campo de texto; el cliente trocea a ~900 kB.
    function maxText() { return 1500000; }

    function isTeacher() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && exists(/databases/$(database)/documents/admins/$(request.auth.token.email.lower()));
    }

    function isChunk(data) {
      return data.keys().hasOnly(['index', 'data'])
        && data.index is int
        && data.data is string
        && data.data.size() < maxText();
    }

    function isSlide(data, slideId) {
      return data.keys().hasOnly(['id', 'content', 'contentChunked', 'contentChunkCount'])
        && data.id == slideId
        && (data.content == null || data.content is list);
    }

    function isOutline(data) {
      return data.keys().hasOnly(['v', 'data', 'updatedAt'])
        && data.v == 2
        && data.data is string
        && data.data.size() < maxText()
        && data.updatedAt is number;
    }

    // Contenido de cada tema.
    match /slides/{slideId} {
      allow read: if true;
      allow create, update: if isTeacher() && isSlide(request.resource.data, slideId);
      allow delete: if isTeacher();

      match /contentChunks/{chunkId} {
        allow read: if true;
        allow create, update: if isTeacher() && isChunk(request.resource.data);
        allow delete: if isTeacher();
      }
    }

    // Temario (formato actual).
    match /meta/outline {
      allow read: if true;
      allow create, update: if isTeacher() && isOutline(request.resource.data);
      allow delete: if false;
    }

    // Formato anterior: se conserva legible para migrar; ya no se escribe.
    // Un docente puede borrarlo desde Mantenimiento.
    match /meta/fullIndex {
      allow read: if true;
      allow create, update: if false;
      allow delete: if isTeacher();

      match /indexChunks/{chunkId} {
        allow read: if true;
        allow create, update: if false;
        allow delete: if isTeacher();
      }
    }

    // Lista de docentes. Cada quien solo puede consultar su propio registro;
    // nadie puede listarla ni modificarla desde la app.
    match /admins/{email} {
      allow get: if request.auth != null && request.auth.token.email.lower() == email;
      allow list, create, update, delete: if false;
    }

    // Todo lo demás, cerrado.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
